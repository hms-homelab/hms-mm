# The chip is the build target, not a default: idf.py set-target esp32c3 (C3
# SuperMini) or esp32s3 (M5Stack AtomS3). Chip-only settings live in
# sdkconfig.defaults.<target>, which ESP-IDF applies on top of this file.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_UART_ISR_IN_IRAM=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_VERBOSE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# OTA rollback: a newly flashed image boots PENDING_VERIFY and the bootloader
# reverts to the previous slot unless the app marks itself valid. That is the
# safety net for the miner in particular, which has no USB-free recovery path
# of its own.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# BLE (O2Ring oximetry): NimBLE, central only.
#
# Not Bluedroid: its footprint is why the ring and a held ezShare link did not
# fit in the heap together. This device only scans and connects out to one
# ring, unencrypted, so everything else is off.
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE=0
# Bounded on both sides. 4096 overflows on the .vld download path: GATT
# notification callbacks run ON the host task and push each block onto the
# link from there. 8192 fails to allocate once the heap is busy, and NimBLE
# then reports ready with no host task running.
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=6144
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=0
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_L2CAP_COC_MAX_NUM=0
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
# Peripheral stays ON despite this being a pure central: the GATT server is
# gated by it, and NimBLE's own ble_hs_deinit() calls ble_gatts_stop()
# unconditionally, so turning it off fails to link.
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=n
CONFIG_BT_NIMBLE_NVS_PERSIST=n
# Controller sized for one connection and one scan: each activity instance
# costs 828 B, and the report and duplicate caches are sized for a room with
# one ring rather than a crowd. Every KB here is headroom the moment the stack
# comes up beside the held ezShare link.
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_BLE_ADV_REPORT_FLOW_CTRL_NUM=50
CONFIG_BT_CTRL_SCAN_DUPL_CACHE_SIZE=20
CONFIG_BT_CTRL_ADV_DUP_FILT_MAX=10
